  function mascotSVG(mood='happy',sz=40){let m='<path d="M18.5 30C20 32 24 32 25.5 30" stroke="#0F3D56" stroke-width="2.3" stroke-linecap="round"/>';if(mood==='excited')m='<path d="M17.5 29C19 33.5 25 33.5 26.5 29Z" fill="#0F3D56"/>';else if(mood==='alert')m='<path d="M19 31.5C21 30 23 30 25 31.5" stroke="#0F3D56" stroke-width="2.2" stroke-linecap="round"/>';return `<svg class="ping-mascot" width="${sz}" height="${sz}" viewBox="0 0 44 44" fill="none"><path d="M22 3C22 3 8 18 8 27.5C8 35.5 14.27 41 22 41C29.73 41 36 35.5 36 27.5C36 18 22 3 22 3Z" fill="#FF6B00"/><circle cx="17.5" cy="24.5" r="2.2" fill="#0F3D56"/><circle cx="26.5" cy="24.5" r="2.2" fill="#0F3D56"/>${m}<ellipse cx="16" cy="14" rx="2" ry="4" transform="rotate(20 16 14)" fill="rgba(255,255,255,0.45)"/></svg>`;}
  function launchConfetti(){const c=document.getElementById('confetti-canvas'),ctx=c.getContext('2d');c.width=window.innerWidth;c.height=window.innerHeight;const ps=Array.from({length:40},()=>({x:Math.random()*c.width,y:-20,w:8,h:8,vy:3+Math.random()*4,vx:-2+Math.random()*4,color:['#FF6B00','#059669','#0F3D56','#FBBF24'][Math.floor(Math.random()*4)]}));let f=0;(function t(){ctx.clearRect(0,0,c.width,c.height);ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;ctx.fillStyle=p.color;ctx.fillRect(p.x,p.y,p.w,p.h);});if(++f<75)requestAnimationFrame(t);else ctx.clearRect(0,0,c.width,c.height);})();}
  function quickReceiveSalary(){const u=currentUser();if(!u?.salaryCents)return;const td=new Date().toISOString().split('T')[0];addTransactionsWithInstallments({type:'income',paymentMethod:'pix',installments:1,category:'Salário',desc:'Salário do Mês',amountCents:u.salaryCents,date:td.startsWith(selectedMonth)?td:`${selectedMonth}-05`,scope:'personal'});saveStore();playPingSound();launchConfetti();renderAll();showToast('Salário pingou! 🎉','💸');}

  let activeRecognition=null, voiceFromHome=false;
  async function startVoiceRecognition(fh=false){voiceFromHome=fh;document.getElementById('voice-fallback-area').style.display='none';document.getElementById('voice-ring').classList.add('listening');document.getElementById('voice-status').textContent='Solicitando microfone...';openModal('modal-voice');if(navigator.mediaDevices?.getUserMedia){try{const s=await navigator.mediaDevices.getUserMedia({audio:true});s.getTracks().forEach(t=>t.stop());}catch(e){showVoiceError('Permissão negada.');return;}}const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){showVoiceError('Navegador sem ditado nativo.');return;}try{activeRecognition=new SR();activeRecognition.lang='pt-BR';activeRecognition.interimResults=true;activeRecognition.onstart=()=>document.getElementById('voice-status').textContent='Pode falar...';activeRecognition.onresult=(ev)=>{let ft='',im='';for(let i=ev.resultIndex;i<ev.results.length;i++){if(ev.results[i].isFinal)ft+=ev.results[i][0].transcript;else im+=ev.results[i][0].transcript;}document.getElementById('voice-transcript').textContent=`"${ft||im}"`;if(ft.trim()){stopVoiceRecognition();if(voiceFromHome)switchTab('chat');sendQuickPrompt(ft.trim());}};activeRecognition.onerror=(ev)=>showVoiceError(`Erro (${ev.error}).`);activeRecognition.start();}catch(e){showVoiceError('Erro ao iniciar.');}}
  function showVoiceError(m){document.getElementById('voice-ring').classList.remove('listening');document.getElementById('voice-status').textContent='Indisponível';document.getElementById('voice-error-msg').textContent=m;document.getElementById('voice-fallback-area').style.display='block';}
  function stopVoiceRecognition(){if(activeRecognition){try{activeRecognition.stop();}catch(e){}activeRecognition=null;}closeModal('modal-voice');}
  function simulateVoicePhrase(){stopVoiceRecognition();if(voiceFromHome)switchTab('chat');sendQuickPrompt('hoje fiz uma viagem com minha namorada, gastamos 120 de gasolina, 150 alimentação, e 100 de lembrancinha');}

  function formatBRL(c,m=true){const u=currentUser();if(m&&u&&u.hideBalances)return 'R$ •••••';return 'R$ '+((c||0)/100).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});}
  function getNowTime(){return new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});}
  function formatDateBR(iso){if(!iso)return '';const[,m,d]=iso.split('-');return iso===new Date().toISOString().split('T')[0]?'Hoje':`${d}/${m}`;}
  function normalizeStr(s){return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');}
  function showToast(msg,ic='💧'){const el=document.getElementById('toast');document.getElementById('toast-icon').textContent=ic;document.getElementById('toast-msg').textContent=msg;el.classList.add('show');clearTimeout(window._tt);window._tt=setTimeout(()=>el.classList.remove('show'),3200);}
  let pendingConfirmAction=null;
  function askConfirm(t,d,fn){document.getElementById('confirm-title').textContent=t;document.getElementById('confirm-desc').textContent=d;pendingConfirmAction=fn;openModal('modal-confirm');}
  document.getElementById('confirm-yes-btn').onclick=()=>{closeModal('modal-confirm');if(pendingConfirmAction)pendingConfirmAction();pendingConfirmAction=null;};
  function switchTab(id){document.querySelectorAll('.tab-view').forEach(e=>e.classList.remove('active'));document.getElementById(`tab-${id}`).classList.add('active');document.querySelectorAll('.nav-item').forEach(b=>b.classList.toggle('active',b.dataset.tab===id));document.querySelectorAll('.sidebar-btn').forEach(b=>b.classList.toggle('active',b.getAttribute('onclick')?.includes(`'${id}'`)));if(id==='reports')renderReports();if(id==='bills')renderBills();if(id==='chat')scrollChatBottom();}
  function scrollChatBottom(){const el=document.getElementById('chat-messages');if(el)el.scrollTop=el.scrollHeight;}
  function pushMessage(s,t,c=null){const u=currentUser();u.messages.push({id:'m_'+Date.now()+Math.random(),sender:s,text:t,time:getNowTime(),card:c});saveStore();renderChat();}
  function sendQuickPrompt(t){document.getElementById('chat-input').value=t;handleChatSubmit(new Event('submit'));}
  function handleChatSubmit(e){e.preventDefault();const i=document.getElementById('chat-input'),t=i.value.trim();if(!t)return;i.value='';pushMessage('user',t);setTimeout(()=>processPingAI(t),180);}
  function toggleDarkMode(){const u=currentUser();u.darkMode=!u.darkMode;document.body.classList.toggle('dark',u.darkMode);saveStore();}
  function toggleLargeText(){const u=currentUser();u.largeText=!u.largeText;document.body.classList.toggle('large-text',u.largeText);document.getElementById('toggle-large').checked=u.largeText;document.getElementById('btn-font').style.background=u.largeText?'var(--brand-orange)':'var(--bg-card)';saveStore();}
  function toggleHideBalances(){const u=currentUser();u.hideBalances=!u.hideBalances;document.getElementById('toggle-hide').checked=u.hideBalances;document.getElementById('btn-eye').textContent=u.hideBalances?'🙈':'👁️';saveStore();renderAll();}
  function toggleSoundPref(){const u=currentUser();u.soundEnabled=document.getElementById('toggle-sound').checked;saveStore();if(u.soundEnabled)playPingSound();}
  function setScopeFilter(s,b){const u=currentUser();u.scopeFilter=s;document.querySelectorAll('.chips-row .chip').forEach(c=>c.classList.remove('active'));b.classList.add('active');saveStore();renderHome();}
  function payBill(id){const u=currentUser(),b=u.bills.find(x=>x.id===id);if(!b||b.paid)return;if(b.amountCents<=0){openBillModal(id);return;}b.paid=true;addTransactionsWithInstallments({type:'expense',paymentMethod:'pix',installments:1,category:b.category,desc:`Pgto ${b.name}`,amountCents:b.amountCents,date:new Date().toISOString().split('T')[0],scope:'personal'});saveStore();renderAll();showToast(`"${b.name}" paga! ✅`,'✅');}
  function resetBillsForNewMonth(){currentUser().bills.forEach(b=>b.paid=false);saveStore();renderAll();showToast('Renovadas!','🔄');}
  function openBillModal(eid=null){const u=currentUser();document.getElementById('bill-edit-id').value=eid||'';const d=document.getElementById('btn-delete-bill-modal');if(eid){const b=u.bills.find(x=>x.id===eid);document.getElementById('modal-bill-title').textContent='✏️ Editar Conta';document.getElementById('bill-name').value=b.name;document.getElementById('bill-amount').value=b.amountCents?(b.amountCents/100).toFixed(2):'';document.getElementById('bill-day').value=b.dueDay;document.getElementById('bill-cat').value=b.category;d.style.display='inline-flex';}else{document.getElementById('modal-bill-title').textContent='📅 Nova Conta';document.getElementById('bill-name').value='';document.getElementById('bill-amount').value='';document.getElementById('bill-day').value=15;d.style.display='none';}openModal('modal-bill');}
  function saveBillForm(e){e.preventDefault();const u=currentUser(),eid=document.getElementById('bill-edit-id').value,obj={name:document.getElementById('bill-name').value.trim(),amountCents:toCentsExact(document.getElementById('bill-amount').value),dueDay:parseInt(document.getElementById('bill-day').value,10),category:document.getElementById('bill-cat').value};if(eid){const i=u.bills.findIndex(b=>b.id===eid);if(i!==-1)u.bills[i]={...u.bills[i],...obj};}else u.bills.push({id:'b_'+Date.now(),...obj,paid:false});saveStore();closeModal('modal-bill');renderAll();showToast('Conta salva!','📅');}
  function askDeleteBill(id){const u=currentUser(),b=u.bills.find(x=>x.id===id);askConfirm('Excluir conta?',`Apagar "${b.name}"?`,()=>{u.bills=u.bills.filter(x=>x.id!==id);saveStore();renderAll();});}
  function deleteCurrentEditingBill(){const id=document.getElementById('bill-edit-id').value;closeModal('modal-bill');if(id)askDeleteBill(id);}
  function openGoalModal(eid=null){const u=currentUser();document.getElementById('goal-edit-id').value=eid||'';const d=document.getElementById('btn-delete-goal-modal');if(eid){const g=u.goals.find(x=>x.id===eid);document.getElementById('modal-goal-title').textContent='✏️ Editar Meta';document.getElementById('goal-name').value=g.name;document.getElementById('goal-target').value=(g.targetCents/100).toFixed(2);document.getElementById('goal-current').value=(g.currentCents/100).toFixed(2);document.getElementById('goal-date').value=g.date;d.style.display='inline-flex';}else{document.getElementById('modal-goal-title').textContent='🎯 Nova Meta';document.getElementById('goal-name').value='';document.getElementById('goal-target').value='';document.getElementById('goal-current').value='0';document.getElementById('goal-date').value='2027-12-31';d.style.display='none';}openModal('modal-goal');}
  function saveGoalForm(e){e.preventDefault();const u=currentUser(),eid=document.getElementById('goal-edit-id').value,obj={name:document.getElementById('goal-name').value.trim(),targetCents:toCentsExact(document.getElementById('goal-target').value),currentCents:toCentsExact(document.getElementById('goal-current').value),date:document.getElementById('goal-date').value};if(eid){const i=u.goals.findIndex(g=>g.id===eid);if(i!==-1)u.goals[i]={...u.goals[i],...obj};}else u.goals.push({id:'g_'+Date.now(),...obj});saveStore();closeModal('modal-goal');renderAll();showToast('Meta salva!','🎯');}
  function askDeleteGoal(id){const u=currentUser(),g=u.goals.find(x=>x.id===id);askConfirm('Excluir meta?',`Apagar "${g.name}"?`,()=>{u.goals=u.goals.filter(x=>x.id!==id);saveStore();renderAll();});}
  function deleteCurrentEditingGoal(){const id=document.getElementById('goal-edit-id').value;closeModal('modal-goal');if(id)askDeleteGoal(id);}
  function openGoalMoveModal(id){const g=currentUser().goals.find(x=>x.id===id);document.getElementById('goal-move-id').value=id;document.getElementById('goal-move-name').textContent=g.name;openModal('modal-goal-move');}
  function applyGoalMove(dir){const u=currentUser(),g=u.goals.find(x=>x.id===document.getElementById('goal-move-id').value),v=toCentsExact(document.getElementById('goal-move-val').value);if(!g||v<=0)return;g.currentCents=Math.max(0,g.currentCents+v*dir);saveStore();closeModal('modal-goal-move');renderAll();if(dir>0){playPingSound();launchConfetti();showToast('Guardado! 🐷','🎉');}}
  function editCurrentProfile(){const u=currentUser();document.getElementById('ep-name').value=u.name;document.getElementById('ep-role').value=u.role;document.getElementById('ep-salary').value=u.salaryCents?(u.salaryCents/100).toFixed(2):'';openModal('modal-edit-profile');}
  function saveProfileEdit(e){e.preventDefault();const u=currentUser();u.name=document.getElementById('ep-name').value.trim();u.role=document.getElementById('ep-role').value;u.salaryCents=toCentsExact(document.getElementById('ep-salary').value);saveStore();closeModal('modal-edit-profile');renderAll();showToast('Salvo!','✅');}
  function askDeleteCurrentUser(){const u=currentUser();askConfirm(`Excluir "${u.name}"?`,'Apaga dados deste usuário.',()=>{store.users=store.users.filter(x=>x.id!==u.id);store.activeUserId=null;saveStore();document.body.classList.remove('dark','large-text');renderOnboarding();});}
  function exportCSV(){const u=currentUser(),rows=u.transactions.map(t=>`${t.date},${t.type},${t.paymentMethod||'pix'},"${t.category}","${t.desc}",${(t.amountCents/100).toFixed(2)}`).join('\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['Data,Tipo,Meio,Categoria,Descricao,Valor\n'+rows],{type:'text/csv'}));a.download=`pingou-${u.name}.csv`;a.click();}
  function exportBackupJSON(){const u=currentUser(),a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(u,null,2)],{type:'application/json'}));a.download=`backup-pingou-${u.name}.json`;a.click();}
  function importBackupJSON(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);d.id='u_'+Date.now();store.users.push(d);store.activeUserId=d.id;saveStore();enterApp();showToast('Restaurado!','💾');}catch(err){showToast('Inválido!','⚠️');}};r.readAsText(f);}
  function openModal(id){document.getElementById(id).classList.add('open');}
  function closeModal(id){document.getElementById(id).classList.remove('open');}
  function closeModalOnBackdrop(e,id){if(e.target.id===id){if(id==='modal-voice')stopVoiceRecognition();else closeModal(id);}}
  function renderAll(){renderHome();renderChat();renderReports();renderBills();}

  if (currentUser()) enterApp(); else renderOnboarding();
</script>
</body>
</html>

