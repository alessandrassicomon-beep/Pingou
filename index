<script>
  const USERS_STORE_KEY = 'pingou_ai_v8';
  const CATEGORY_META = {
    'Salário': { icon: '💼', color: '#059669', type: 'income' },
    'Vendas / Comissões': { icon: '🛍️', color: '#10B981', type: 'income' },
    'Vale Alimentação': { icon: '🥗', color: '#34D399', type: 'income' },
    'PIX Recebidos': { icon: '💸', color: '#FF6B00', type: 'income' },
    'Freelancers': { icon: '💻', color: '#0F3D56', type: 'income' },
    'Saldo Inicial': { icon: '🏦', color: '#6366F1', type: 'income' },
    'Ajuste de Saldo': { icon: '⚖️', color: '#0EA5E9', type: 'income' },
    'Outros Ganhos': { icon: '✨', color: '#8B5CF6', type: 'income' },

    'Mercado': { icon: '🛒', color: '#FF6B00', type: 'expense' },
    'Alimentação': { icon: '🍽️', color: '#F59E0B', type: 'expense' },
    'Combustível': { icon: '⛽', color: '#DC2626', type: 'expense' },
    'Internet': { icon: '🌐', color: '#0F3D56', type: 'expense' },
    'Energia': { icon: '⚡', color: '#D97706', type: 'expense' },
    'Água': { icon: '💧', color: '#0EA5E9', type: 'expense' },
    'Aluguel': { icon: '🏠', color: '#6366F1', type: 'expense' },
    'Transporte': { icon: '🚗', color: '#EC4899', type: 'expense' },
    'Saúde': { icon: '💊', color: '#14B8A6', type: 'expense' },
    'Lazer': { icon: '🍿', color: '#8B5CF6', type: 'expense' },
    'Assinaturas': { icon: '📱', color: '#64748B', type: 'expense' },
    'Cartão de Crédito': { icon: '💳', color: '#6D28D9', type: 'expense' },
    'Ajuste de Saldo ': { icon: '⚖️', color: '#0EA5E9', type: 'expense' },
    'Outros': { icon: '📦', color: '#94A3B8', type: 'expense' }
  };

  function toCentsExact(valStr) {
    if (valStr === null || valStr === undefined) return 0;
    const s = String(valStr).trim().replace(',', '.');
    if (!s || isNaN(Number(s))) return 0;
    const neg = s.startsWith('-'), clean = s.replace('-', ''), [ip = '0', dp = ''] = clean.split('.');
    const cents = parseInt(ip || '0', 10) * 100 + parseInt((dp + '00').slice(0, 2), 10);
    return neg ? -cents : cents;
  }

  let store = loadStore();
  function loadStore() { try { const r = localStorage.getItem(USERS_STORE_KEY); if (r) return JSON.parse(r); } catch(e){} return { activeUserId: null, users: [] }; }
  function saveStore() { try { localStorage.setItem(USERS_STORE_KEY, JSON.stringify(store)); } catch(e){} }
  function currentUser() { return store.users.find(u => u.id === store.activeUserId) || null; }

  let selectedMonth = getCurrentYearMonth();
  function getCurrentYearMonth() { const n = new Date(); return `${n.getFullYear()}-${String(n.getMonth() + 1).padStart(2, '0')}`; }
  function addMonthsYM(ym, add) { const [y, m] = ym.split('-').map(Number), d = new Date(y, m - 1 + add, 1); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`; }
  function formatMonthLabel(ym) { const [y, m] = ym.split('-').map(Number); return new Date(y, m - 1, 1).toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' }).replace('.', ''); }
  function changeMonth(delta) { selectedMonth = addMonthsYM(selectedMonth, delta); renderAll(); }

  function renderOnboarding() {
    document.getElementById('app-shell').style.display = 'none';
    document.getElementById('onboarding-screen').style.display = 'flex';
    const listBox = document.getElementById('existing-profiles-box'), newForm = document.getElementById('new-profile-form'), backBtn = document.getElementById('ob-back-btn');
    if (store.users.length > 0) {
      listBox.style.display = 'block'; newForm.style.display = 'none'; backBtn.style.display = 'inline-flex';
      document.getElementById('existing-profiles-list').innerHTML = store.users.map(u => `<div class="profile-pick-card" onclick="selectUser('${u.id}')"><div class="avatar-circle">${u.name.trim().slice(0,2).toUpperCase()}</div><div style="flex:1;"><strong style="display:block;">${u.name}</strong><small style="color:var(--text-secondary);">${u.role}</small></div><span style="font-weight:700; color:var(--brand-orange-accessible);">Entrar →</span></div>`).join('');
    } else { listBox.style.display = 'none'; newForm.style.display = 'block'; backBtn.style.display = 'none'; }
  }
  function showNewProfileForm() { document.getElementById('existing-profiles-box').style.display = 'none'; document.getElementById('new-profile-form').style.display = 'block'; }
  function selectUser(id) { store.activeUserId = id; saveStore(); enterApp(); }
  function switchUserAccount() { store.activeUserId = null; saveStore(); document.body.classList.remove('dark', 'large-text'); renderOnboarding(); }

  function completeOnboarding(e) {
    e.preventDefault();
    const name = document.getElementById('ob-name').value.trim(), role = document.getElementById('ob-role').value;
    const salaryCents = toCentsExact(document.getElementById('ob-salary').value), initCents = toCentsExact(document.getElementById('ob-initial-balance').value);
    const today = new Date().toISOString().split('T')[0], txs = [], bills = [];
    if (initCents > 0) txs.push({ id: 't_init_' + Date.now(), type: 'income', paymentMethod: 'pix', category: 'Saldo Inicial', desc: 'Saldo inicial em conta', amountCents: initCents, date: today, scope: 'personal' });
    document.querySelectorAll('.preset-bill-row').forEach((row, i) => {
      const chk = row.querySelector('.ob-bill-check'), valInput = row.querySelector('.preset-bill-val');
      if (chk && chk.checked) bills.push({ id: 'b_' + Date.now() + '_' + i, name: chk.dataset.name, category: chk.dataset.cat, amountCents: toCentsExact(valInput?.value || 0), dueDay: parseInt(chk.dataset.day, 10), paid: false });
    });

    const daysLeft = getDaysRemainingInMonth(getCurrentYearMonth());
    const welcomeExtra = initCents > 0 ? `Pelos dias que faltam no mês, você pode gastar cerca de <strong>${formatBRL(Math.round(initCents / daysLeft), false)} por dia</strong>.` : `Fale naturalmente seus ganhos, vendas ou gastos!`;
    const newUser = {
      id: 'u_' + Date.now(), name, role, salaryCents, darkMode: false, largeText: false, hideBalances: false, soundEnabled: true, scopeFilter: 'all',
      geminiApiKey: '', learnedRules: [], lastSeenMonth: getCurrentYearMonth(), chatPending: null, lastChatTxId: null,
      transactions: txs, bills, goals: [],
      messages: [{ id: 'm_w_' + Date.now(), sender: 'ping', text: `Oi <strong>${name}</strong>! 👋\n${welcomeExtra}`, time: getNowTime(), card: null }]
    };
    store.users.push(newUser); store.activeUserId = newUser.id; saveStore(); e.target.reset(); enterApp(); playPingSound();
  }

  function enterApp() {
    const u = currentUser(); if (!u) { renderOnboarding(); return; }
    document.getElementById('onboarding-screen').style.display = 'none';
    document.getElementById('app-shell').style.display = 'flex';
    selectedMonth = getCurrentYearMonth();
    document.body.classList.toggle('dark', !!u.darkMode); document.getElementById('toggle-dark').checked = !!u.darkMode;
    document.body.classList.toggle('large-text', !!u.largeText); document.getElementById('toggle-large').checked = !!u.largeText;
    document.getElementById('btn-font').style.background = u.largeText ? 'var(--brand-orange)' : 'var(--bg-card)';
    document.getElementById('toggle-hide').checked = !!u.hideBalances; document.getElementById('btn-eye').textContent = u.hideBalances ? '🙈' : '👁️';
    document.getElementById('toggle-sound').checked = u.soundEnabled !== false;
    document.getElementById('gemini-api-key-input').value = u.geminiApiKey || '';
    updateAIModeUI(); renderAll(); checkDueAlarms(true);
  }

  function saveGeminiKey() {
    const u = currentUser(); if (!u) return;
    u.geminiApiKey = document.getElementById('gemini-api-key-input').value.trim();
    saveStore(); updateAIModeUI();
    showToast(u.geminiApiKey ? 'IA Real (Gemini) conectada! 🧠' : 'Chave removida.', '🧠');
  }

  function updateAIModeUI() {
    const u = currentUser(); if (!u) return;
    document.getElementById('ai-mode-badge').textContent = u.geminiApiKey
      ? 'IA Generativa Ativa (Google Gemini + Memória)'
      : 'Modo Inteligente Local (Conecte Gemini em Perfil)';
    const memBox = document.getElementById('learned-memory-box'), count = (u.learnedRules || []).length;
    memBox.innerHTML = count > 0 ? `📚 <strong>Aprendizado:</strong> ${count} correção(ões) memorizada(s).` : `📚 <strong>Aprendizado Contínuo:</strong> Suas correções no chat treinam o Ping.`;
  }

  async function callGeminiAI(userMessage) {
    const u = currentUser(), snap = getFinancialSnapshot('all', selectedMonth);
    const categoriesList = Object.keys(CATEGORY_META).join(', ');
    const learnedText = (u.learnedRules || []).slice(-10).map(r => `- "${r.phrase}" -> ${r.correction}`).join('\n');
    const systemPrompt = `Você é o PING, assessor financeiro brasileiro do PINGOU. Hoje: ${new Date().toISOString().split('T')[0]}. Categorias válidas: ${categoriesList}. Responda ESTRITAMENTE em JSON: {"action":"create_transactions"|"query_reply"|"correct_last","reply":"msg curta","transactions":[{"type":"income"|"expense","desc":"nome curto","amount_cents":2000,"category":"categoria","scope":"personal"|"business","payment_method":"pix"|"credit","installments":1}],"correction":{"new_type":"income"|"expense"|null,"new_amount_cents":null}}. Aprendizado:\n${learnedText}`;

    const resp = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent?key=${encodeURIComponent(u.geminiApiKey)}`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ systemInstruction: { parts: [{ text: systemPrompt }] }, contents: [{ role: 'user', parts: [{ text: userMessage }] }], generationConfig: { responseMimeType: 'application/json', temperature: 0.1 } })
    });
    if (!resp.ok) throw new Error('API Error ' + resp.status);
    const data = await resp.json();
    return JSON.parse(data.candidates?.[0]?.content?.parts?.[0]?.text);
  }

  // ==================== MOTOR NLP CORRIGIDO (PLURAL + SEM CORTAR "120 REAIS DE GASOLINA" NO MEIO) ====================
  const ACTION_VERBS_REGEX = /\b(gastei|gastamos|paguei|pagamos|comprei|compramos|torrei|torramos|investi|investimos|vendi|vendemos|faturei|faturamos|lucrei|lucramos|recebi|recebemos|ganhei|ganhamos|cobrei|cobramos|caiu|pingou|entrou)\b/i;

  function wordNumbersToDigitsExceptOne(str) {
    const map = { dois: '2', duas: '2', tres: '3', quatro: '4', cinco: '5', seis: '6', sete: '7', oito: '8', nove: '9', dez: '10' };
    return str.replace(/\b(dois|duas|tres|quatro|cinco|seis|sete|oito|nove|dez)\b/gi, m => map[m.toLowerCase()] || m);
  }

  function detectCountableQuantity(rawText) {
    const norm = wordNumbersToDigitsExceptOne(normalizeStr(rawText));
    const m = norm.match(/\b(\d+)\s*(perfumes?|produtos?|unidades?|pecas?|caixas?|itens?|cremes?|hidratantes?|hidrantes?|bolos?|marmitas?)\b/i);
    if (m) { const n = parseInt(m[1], 10); if (n > 1 && n < 100) return n; }
    return 1;
  }

  function extractMoneySmart(rawText, hasParentActionVerb = false) {
    let norm = wordNumbersToDigitsExceptOne(normalizeStr(rawText));
    const qtyPattern = /\b\d+\s*(perfumes?|produtos?|unidades?|pecas?|caixas?|itens?|cremes?|hidratantes?|hidrantes?|dias?|meses|anos|pessoas?|vezes)\b/gi;
    const withoutQty = norm.replace(qtyPattern, ' ').replace(/\b\d{1,2}\s*x\b/gi, ' ').replace(/R\$/gi, 'R$ ');

    let match = withoutQty.match(/r\$\s*(\d+(?:[.,]\d{1,2})?)/i)
             || withoutQty.match(/(\d+(?:[.,]\d{1,2})?)\s*(?:reais|real|conto|contos|pila)\b/i)
             || withoutQty.match(/(?:gastei|gastamos|paguei|pagamos|comprei|compramos|torrei|torramos|recebi|recebemos|faturei|faturamos|lucrei|lucramos|lucro|ganhei|entrou|foi|valor)\s*(?:de\s*)?(\d+(?:[.,]\d{1,2})?)\b/i);

    if (!match && hasParentActionVerb) {
      // Aceita "120 de gasolina", "150 alimentação", "100 de lembrancinha" mesmo sem "reais"!
      match = withoutQty.match(/(?:^|\s)(\d+(?:[.,]\d{1,2})?)(?=\s+(?:de|do|da|na|no|em|pro|pra|[a-z]{3,}|$))/i);
    }
    if (!match) return null;
    const cents = toCentsExact(match[1]);
    return cents > 0 ? cents : null;
  }

  function extractCleanItemDescription(clause) {
    let d = clause.trim()
      // Remove verbos de ação no início ou isolados
      .replace(/\b(?:gastei|gastamos|paguei|pagamos|comprei|compramos|torrei|torramos|recebi|recebemos|vendi|vendemos|faturei|faturamos|lucrei|lucramos)\b/gi, ' ')
      .replace(/\btive\s+(?:um\s+)?lucro\b/gi, ' ')
      // Remove valores monetários ("120 reais", "R$ 150", "100")
      .replace(/\b(?:r\$\s*)?\d+(?:[.,]\d{1,2})?\s*(?:reais|real|conto|contos|pila)?\b/gi, ' ')
      .replace(/\bem\s+(?:cada|casa)\s*(?:um|uma)?\b/gi, ' ')
      .replace(/\b(?:no\s+credito|no\s+debito|no\s+pix|em\s+\d{1,2}x)\b/gi, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      // Limpa preposições sobrando nas pontas ("de gasolina" -> "gasolina")
      .replace(/^(?:de|do|da|dos|das|no|na|nos|nas|em|com|por|para|pro|pra)\s+/i, '')
      .replace(/\s+(?:de|do|da|em|no|na)$/i, '')
      .trim();

    if (!d || d.length < 2) return '';
    return d.charAt(0).toUpperCase() + d.slice(1);
  }

  function inferMetaFromText(fullText) {
    const t = normalizeStr(fullText);
    const isIncome = /\b(vendi|vendemos|venda|vendas|faturei|faturamos|lucro|lucrei|lucramos|recebi|recebemos|caiu|pingou|ganhei|entrou|cobrei|freela|salario|vale)\b/.test(t)
                  && !/\b(gastei|gastamos|paguei|pagamos|comprei|compramos|torrei|torramos|no credito)\b/.test(t);
    const isCredit = /\b(credito|cartao|parcela)\b|\b\d{1,2}x\b/.test(t);
    const instMatch = t.match(/(?:em\s*)?(\d{1,2})\s*(?:x|vezes)/);
    const installments = (isCredit && instMatch) ? Math.min(12, Math.max(1, parseInt(instMatch[1], 10))) : 1;

    let category = isIncome ? 'PIX Recebidos' : 'Outros';
    if (isIncome) {
      if (/\b(vendi|vendemos|venda|vendas|faturei|faturamos|lucro|lucrei|perfume|creme|hidrante|boticario|natura|sex shop|sex shopp|produto|loja|cliente)\b/.test(t)) category = 'Vendas / Comissões';
      else if (t.includes('vale alimentacao')) category = 'Vale Alimentação';
      else if (t.includes('salario')) category = 'Salário';
      else if (t.includes('freela')) category = 'Freelancers';
    } else {
      if (/gasolina|etanol|combustivel|posto/.test(t)) category = 'Combustível';
      else if (/alimentacao|almoco|jantar|lanche|restaurante|cafe|ifood|pizza|sorvete/.test(t)) category = 'Alimentação';
      else if (/mercado|supermercado|padaria|acougue|feira|pao/.test(t)) category = 'Mercado';
      else if (/uber|99|onibus|metro|passagem|pedagio/.test(t)) category = 'Transporte';
      else if (/farmacia|remedio|medico|consulta/.test(t)) category = 'Saúde';
      else if (/lembrancinha|presente|viagem|cinema|passeio|hotel|tenis|roupa|shopping/.test(t)) category = 'Lazer';
      else if (/internet|wifi/.test(t)) category = 'Internet';
      else if (/energia|luz/.test(t)) category = 'Energia';
      else if (/agua/.test(t)) category = 'Água';
      else if (/aluguel/.test(t)) category = 'Aluguel';
    }
    const scope = /\b(vendi|vendemos|venda|vendas|faturei|faturamos|lucro|lucrei|perfume|creme|hidrante|boticario|sex shop|sex shopp|cliente|trabalho|freela|mei)\b/.test(t) ? 'business' : 'personal';
    return { isIncome, isCredit, installments, category, scope };
  }

  async function processPingAI(rawText) {
    const u = currentUser(); if (!u) return;
    const today = new Date().toISOString().split('T')[0];

    if (u.geminiApiKey) {
      try {
        const ai = await callGeminiAI(rawText);
        if (ai.action === 'create_transactions' && Array.isArray(ai.transactions) && ai.transactions.length > 0) {
          const createdList = ai.transactions.map(item => addTransactionsWithInstallments({
            type: item.type === 'income' ? 'income' : 'expense',
            paymentMethod: item.payment_method === 'credit' ? 'credit' : 'pix',
            installments: item.installments || 1,
            category: CATEGORY_META[item.category] ? item.category : (item.type === 'income' ? 'PIX Recebidos' : 'Outros'),
            desc: item.desc,
            amountCents: Math.max(1, Math.round(item.amount_cents)),
            date: today,
            scope: item.scope === 'business' ? 'business' : 'personal'
          })[0]);
          saveStore(); renderAll();
          if (createdList.some(x => x.type === 'income')) { playPingSound(); launchConfetti(); }
          pushMessage('ping', ai.reply || 'Anotado! 🧠', createdList.length > 1 ? { kind: 'multi_tx_saved', txs: createdList } : { kind: 'tx_saved', tx: createdList[0] });
          return;
        }
        if (ai.action === 'correct_last' && u.lastChatTxId) {
          const lastTx = u.transactions.find(t => t.id === u.lastChatTxId);
          if (lastTx && ai.correction) {
            if (ai.correction.new_type) lastTx.type = ai.correction.new_type;
            if (ai.correction.new_amount_cents) lastTx.amountCents = ai.correction.new_amount_cents;
            u.learnedRules = u.learnedRules || []; u.learnedRules.push({ phrase: lastTx.desc, correction: ai.reply });
            saveStore(); renderAll(); updateAIModeUI();
            pushMessage('ping', ai.reply, { kind: 'tx_saved', tx: lastTx });
            return;
          }
        }
        if (ai.action === 'query_reply' && ai.reply) { pushMessage('ping', ai.reply); return; }
      } catch (err) { console.warn('Fallback local:', err); }
    }

    const text = normalizeStr(rawText);

    if (u.chatPending && u.chatPending.type === 'complete_tx_amount') {
      let cents = extractMoneySmart(rawText, true);
      if (cents) {
        const draft = u.chatPending.draft;
        if (draft.qty > 1 && /\bcada\b|\bcada um\b|\bcasa um\b/.test(text)) cents *= draft.qty;
        u.chatPending = null;
        const [tx] = addTransactionsWithInstallments({ ...draft, amountCents: cents, date: today });
        saveStore(); renderAll();
        if (tx.type === 'income') { playPingSound(); launchConfetti(); }
        pushMessage('ping', `Perfeito! 🎉`, { kind: 'tx_saved', tx });
        return;
      }
      pushMessage('ping', 'Digite só o valor em reais (ex: <strong>70</strong>) 😊');
      return;
    }

    const wantsFlipToIncome = /(esse|este|esse valor|isso).*(entrou|entrada|ganho|receita|lucro)/.test(text) || /entrou\s*(?:e\s*)?nao\s*saiu|nao\s*saiu.*entrou|era\s*entrada/.test(text);
    const wantsFlipToExpense = /(esse|este|esse valor|isso).*(saiu|despesa|gasto)/.test(text) || /saiu\s*(?:e\s*)?nao\s*entrou/.test(text);
    const wantsDeleteLast = /\b(apaga|apagar|exclui|excluir|desfaz|cancela)\b/.test(text) && text.length < 40;
    const wantsFixAmount = /\b(na verdade|errei|corrige|muda|altera)\b/.test(text) && extractMoneySmart(rawText, true);

    if (u.lastChatTxId && (wantsFlipToIncome || wantsFlipToExpense || wantsDeleteLast || wantsFixAmount)) {
      const lastTx = u.transactions.find(t => t.id === u.lastChatTxId);
      if (lastTx) {
        if (wantsDeleteLast) { u.transactions = u.transactions.filter(t => t.id !== lastTx.id); u.lastChatTxId = null; saveStore(); renderAll(); pushMessage('ping', `Apaguei <strong>"${lastTx.desc}"</strong>! 🗑️`); return; }
        if (wantsFlipToIncome || wantsFlipToExpense) {
          lastTx.type = wantsFlipToIncome ? 'income' : 'expense';
          if (lastTx.type === 'income' && lastTx.category === 'Outros') lastTx.category = 'Vendas / Comissões';
          u.learnedRules = u.learnedRules || []; u.learnedRules.push({ phrase: lastTx.desc, correction: `É ${lastTx.type==='income'?'Entrada':'Saída'}` });
          saveStore(); renderAll(); updateAIModeUI();
          if (lastTx.type === 'income') { playPingSound(); launchConfetti(); }
          pushMessage('ping', `Corrigido e memorizado! 🧠`, { kind: 'tx_saved', tx: lastTx }); return;
        }
        if (wantsFixAmount) { lastTx.amountCents = extractMoneySmart(rawText, true); saveStore(); renderAll(); pushMessage('ping', `Valor atualizado! ✏️`, { kind: 'tx_saved', tx: lastTx }); return; }
      }
    }

    if (text.includes('fechar mes') || text.includes('resumo do mes')) { generateMonthSummaryMessage(selectedMonth, false); return; }
    if (text.includes('quanto posso') || text.includes('disponivel') || text.includes('saldo')) {
      const snap = getFinancialSnapshot('all', selectedMonth);
      pushMessage('ping', `Você pode gastar até <strong>${formatBRL(snap.dailySafe, false)} por dia</strong> pelos próximos ${snap.daysLeft} dias.\n\n• Em conta: <strong>${formatBRL(snap.cashBalance, false)}</strong>\n• Cartão: <strong>${formatBRL(snap.cardInvoice, false)}</strong>\n• Contas: <strong>${formatBRL(snap.pendingBills, false)}</strong>`);
      return;
    }

    // FATIADOR INTELIGENTE:
    // 1. Divide primeiro por vírgula, " e ", " tbm ", " a mais ", " e mais "
    const globalMeta = inferMetaFromText(rawText);
    const hasGlobalVerb = ACTION_VERBS_REGEX.test(text);

    const step1Chunks = rawText
      .replace(/^(chat|ping|oi|ola|ei)\s*[,:]\s*/i, '')
      .replace(/\s+(?:a\s+mais|e\s+mais)\s+/gi, ' | ')
      .split(/\s*\|\s*|\s*,\s*|\s+\be\b\s+|\s+\btbm\b\s+|\s+\btambem\b\s+/i)
      .map(s => s.replace(/^(?:a\s+mais|e\s+mais|tbm|tambem)\s+/i, '').replace(/\s+(?:a\s+mais|e\s+mais)$/i, '').trim())
      .filter(Boolean);

    // 2. Só quebra um bloco após "reais" SE aquele mesmo bloco ainda tiver 2 ou mais "reais" juntos (sem vírgula)!
    const clauses = [];
    step1Chunks.forEach(chunk => {
      const cleaned = chunk.replace(/^vendi\s+(?:nessa|esta|essa)?\s*semana\s*:\s*/i, '').trim();
      const reaisMatches = cleaned.match(/\d+(?:[.,]\d{1,2})?\s*(?:reais|real)/gi);
      if (reaisMatches && reaisMatches.length > 1) {
        cleaned.replace(/(\b\d+(?:[.,]\d{1,2})?\s*(?:reais|real))\s+(?=[a-zA-Z])/gi, '$1 | ')
          .split(/\s*\|\s*/).forEach(sub => { if (sub.trim()) clauses.push(sub.trim()); });
      } else if (cleaned) {
        clauses.push(cleaned);
      }
    });

    const itemsToCreate = [];
    let pendingCtx = null;

    clauses.forEach(clause => {
      const cNorm = normalizeStr(clause);
      if (/^(chat|ping|oi|ola)$/.test(cNorm)) return;
      const clauseMoney = extractMoneySmart(clause, hasGlobalVerb);
      const clauseQty = detectCountableQuantity(clause);

      if (!clauseMoney) {
        if (pendingCtx) { pendingCtx.text += ' • ' + clause; if (clauseQty > 1) pendingCtx.qty = clauseQty; }
        else pendingCtx = { text: clause, qty: clauseQty };
      } else {
        // Verifica se a própria cláusula já tem nome de item (ex: "gastamos 120 de gasolina" -> "Gasolina")
        const ownName = extractCleanItemDescription(clause);
        const qty = (pendingCtx && pendingCtx.qty > 1) ? pendingCtx.qty : clauseQty;
        let finalCents = clauseMoney;
        if (qty > 1 && /\bcada\b|\bcada um\b|\bcasa um\b/.test(cNorm)) finalCents = clauseMoney * qty;

        // Só combina com contexto anterior se a cláusula atual NÃO tiver nome próprio (ex: "tive lucro de 20 reais")
        let cleanDesc = ownName || (pendingCtx ? pendingCtx.text.charAt(0).toUpperCase() + pendingCtx.text.slice(1) : clause);
        if (!ownName && pendingCtx && qty > 1 && /\bcada\b|\bcasa um\b/.test(cNorm)) {
          cleanDesc += ` (${formatBRL(clauseMoney, false)} cada)`;
        }

        // Usa a frase completa do item para inferir categoria certa (ex: "viagem" ou "gasolina")
        const metaTarget = ownName ? clause : (pendingCtx ? `${pendingCtx.text} ${clause}` : clause);
        const itemMeta = inferMetaFromText(metaTarget);
        const finalIsIncome = itemMeta.isIncome || (globalMeta.isIncome && !/\b(gastei|gastamos|paguei|pagamos|comprei|compramos)\b/.test(cNorm));
        let finalCat = itemMeta.category;
        if ((finalCat === 'Outros' || finalCat === 'PIX Recebidos') && globalMeta.category !== 'Outros') {
          finalCat = globalMeta.category;
        }
        const finalScope = itemMeta.scope === 'business' ? 'business' : globalMeta.scope;

        itemsToCreate.push({
          type: finalIsIncome ? 'income' : 'expense',
          paymentMethod: itemMeta.isCredit ? 'credit' : 'pix',
          installments: itemMeta.installments,
          category: finalCat,
          desc: cleanDesc,
          amountCents: finalCents,
          date: today,
          scope: finalScope
        });
        pendingCtx = null;
      }
    });

    if (itemsToCreate.length > 1) {
      const createdList = itemsToCreate.map(item => addTransactionsWithInstallments(item)[0]);
      saveStore(); renderAll();
      if (createdList.some(x => x.type === 'income')) { playPingSound(); launchConfetti(); }
      pushMessage('ping', `Show! Separei e anotei os <strong>${createdList.length} itens</strong> certinhos:`, { kind: 'multi_tx_saved', txs: createdList });
      return;
    }

    if (itemsToCreate.length === 1) {
      const item = itemsToCreate[0], created = addTransactionsWithInstallments(item);
      saveStore(); renderAll();
      if (item.type === 'income') { playPingSound(); launchConfetti(); }
      pushMessage('ping', item.installments > 1 ? `Parcelado em <strong>${item.installments}x</strong>! 💳` : (item.type === 'income' ? 'Oba! Dinheiro pingou! 🎉' : 'Anotado! 👍'), { kind: 'tx_saved', tx: created[0] });
      return;
    }

    if (hasGlobalVerb) {
      u.chatPending = { type: 'complete_tx_amount', draft: { type: globalMeta.isIncome ? 'income' : 'expense', paymentMethod: globalMeta.isCredit ? 'credit' : 'pix', installments: globalMeta.installments, category: globalMeta.category, desc: rawText.trim(), scope: globalMeta.scope, qty: detectCountableQuantity(rawText) } };
      saveStore();
      pushMessage('ping', globalMeta.isIncome ? `Qual foi o valor total que entrou?` : `Quanto você gastou?`);
      return;
    }

    pushMessage('ping', 'Não entendi o valor 😅. Tente falar o item e o valor!');
  }

  // ==================== RESTANTE DO APP ====================
  function getDaysRemainingInMonth(ym) { const now = new Date(), [y, m] = ym.split('-').map(Number), lastDay = new Date(y, m, 0).getDate(); return ym === getCurrentYearMonth() ? Math.max(1, lastDay - now.getDate() + 1) : lastDay; }
  function getFinancialSnapshot(scope = 'all', ym = selectedMonth) {
    const u = currentUser(); if (!u) return { cashBalance: 0, cardInvoice: 0, cardItems: [], pendingBills: 0, freeMonth: 0, dailySafe: 0, daysLeft: 1, monthIncome: 0, monthExpenseAll: 0, monthTxs: [], businessProfit: 0, meiReserve: 0 };
    const scopedAll = scope === 'all' ? u.transactions : u.transactions.filter(t => t.scope === scope);
    let cashIn = 0, cashOut = 0; scopedAll.forEach(t => { if (t.type === 'income') cashIn += t.amountCents; else if (t.paymentMethod !== 'credit') cashOut += t.amountCents; });
    const cashBalance = cashIn - cashOut;
    const cardItems = scopedAll.filter(t => t.type === 'expense' && t.paymentMethod === 'credit' && t.date.startsWith(ym) && !t.invoicePaid);
    const cardInvoice = cardItems.reduce((a, b) => a + b.amountCents, 0);
    const pendingBills = u.bills.filter(b => !b.paid && b.amountCents > 0).reduce((a, b) => a + b.amountCents, 0);
    const freeMonth = cashBalance - pendingBills - cardInvoice, daysLeft = getDaysRemainingInMonth(ym), dailySafe = Math.round(freeMonth / daysLeft);
    const monthTxs = scopedAll.filter(t => t.date.startsWith(ym));
    let monthIncome = 0, monthExpenseAll = 0; monthTxs.forEach(t => { if (t.type === 'income') monthIncome += t.amountCents; else if (t.category !== 'Cartão de Crédito') monthExpenseAll += t.amountCents; });
    let bizIn = 0, bizOut = 0; u.transactions.filter(t => t.scope === 'business' && t.date.startsWith(ym)).forEach(t => { if (t.type === 'income') bizIn += t.amountCents; else bizOut += t.amountCents; });
    const businessProfit = bizIn - bizOut, meiReserve = businessProfit > 0 ? Math.round(businessProfit * 0.06) : 0;
    return { cashBalance, cardInvoice, cardItems, pendingBills, freeMonth, dailySafe, daysLeft, monthIncome, monthExpenseAll, monthTxs, businessProfit, meiReserve };
  }

